<?xml version="1.0" encoding="utf-8"?>
<!--
  Device admin policy descriptor for Kinetic Link Kids.
  Declares DISABLE_KEYGUARD_FEATURES (needed to suppress lock-screen during
  kiosk sessions) and LOCK_TASK (full lock task whitelisting when Device Owner).
  See: https://developer.android.com/guide/topics/admin/device-admin
-->
<device-admin>
    <uses-policies>
        <disable-keyguard-features />
        <force-lock />
    </uses-policies>
</device-admin>
