# CouchDB admin credentials — change before deploying!
COUCHDB_USER=kinetic
COUCHDB_PASSWORD=changeme

# Unique ID advertised via mDNS (apps see this as the peer deviceId).
# Keep it stable so devices recognise the hub across restarts.
HUB_ID=kinetic-hub

# CouchDB port (only change if you remap the host port above)
COUCH_PORT=5984

# ---------------------------------------------------------------------------
# Mesh key — 64 hex characters = 32 bytes (AES-256).
#
# Generate a fresh key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Supply the SAME value to both app builds:
#   flutter build apk \
#     --dart-define=MESH_KEY_HEX=<value> \
#     --dart-define=COUCH_USER=kinetic \
#     --dart-define=COUCH_PASSWORD=changeme
#
# The hub stores only encrypted blobs and never needs the mesh key itself.
# ---------------------------------------------------------------------------
# MESH_KEY_HEX=<generate and paste here>
