# CouchDB admin credentials — change before deploying!
COUCHDB_USER=kinetic
COUCHDB_PASSWORD=changeme

# Unique ID advertised via mDNS (apps see this as the peer deviceId).
# Keep it stable so devices recognise the hub across restarts.
HUB_ID=kinetic-hub

# CouchDB port (only change if you remap the host port above)
COUCH_PORT=5984

# ---------------------------------------------------------------------------
# Mesh key — 64 hex characters = 32 bytes (AES-256).  REQUIRED.
#
# Generate a fresh key and paste the output below:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# The enrollment server (http://<hub-ip>:8765/enroll) distributes this key
# to the parent app via QR.  The parent then generates a child-device QR
# from within Settings.  The key is stored on each device in the OS secure
# enclave (Android Keystore / iOS Keychain) — it is never baked into the
# app binary.
# ---------------------------------------------------------------------------
# MESH_KEY_HEX=replace_with_output_of_python3_secrets_token_hex_32
